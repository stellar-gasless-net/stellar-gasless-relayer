# Stellar Gasless Relayer Configuration
PORT=3001
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
RELAYER_SECRETS=SDXXX1...KEY1,SDYYY2...KEY2
MAX_FEE_STROOPS=1000000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
# Comma-separated keys you issue to integrating dApps. st_gas_test_key is the key used in
# CONTRIBUTING.md's curl example — keep it here (or swap it) so that example works locally.
DAPP_API_KEYS=st_gas_test_key
# Both optional — 0 (the default) means unlimited. Protects the sponsor's real balance from
# a single dApp (or a bug) draining it in one day; see README for how these are enforced.
GLOBAL_DAILY_BUDGET_STROOPS=0
PER_KEY_DAILY_BUDGET_STROOPS=0
# Optional, comma-separated. Empty (the default) allows any origin, same as Express's bare
# cors() — set this to your real dashboard/dApp origin(s) before a public deployment.
CORS_ORIGINS=
# Optional. Per-dApp sponsorship policy overrides, as a JSON object keyed by API key — lets
# different keys have different daily budgets, a per-end-user daily sponsored-tx cap, and/or
# a contract allowlist restricting which contracts that key may have sponsored. A key with no
# entry here falls back to PER_KEY_DAILY_BUDGET_STROOPS above with no other restrictions.
# Example (maxSponsoredTxPerVerifiedUserPerDay is optional — see ZKIDENT_* below):
# SPONSOR_POLICIES_JSON={"st_gas_test_key":{"dailyBudgetStroops":500000000,"maxSponsoredTxPerUserPerDay":5,"maxSponsoredTxPerVerifiedUserPerDay":50,"allowedContractIds":["CABC...XYZ"]}}
SPONSOR_POLICIES_JSON=
# Optional. Empty (the default) disables the stellar-zkident credential-tiering integration
# entirely — every user gets maxSponsoredTxPerUserPerDay, unchanged from before this existed.
# Set to a real deployed stellar-zklab/stellar-zkident credential_verifier contract ID to
# enable it: end users holding a verified credential of ZKIDENT_REQUIRED_CREDENTIAL_TYPE then
# get maxSponsoredTxPerVerifiedUserPerDay instead, per-key, wherever a policy sets one. See
# README for how this cross-org dependency actually works.
ZKIDENT_CREDENTIAL_VERIFIER_ID=CDLRSLHALMX6OU5IHWY6CKTROK3SYENEA75K6OWSZCPAW4EOTR2OZGSF
ZKIDENT_REQUIRED_CREDENTIAL_TYPE=kyc_tier_2
